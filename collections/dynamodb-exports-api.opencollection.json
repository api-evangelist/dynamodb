{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon DynamoDB Backups Exports API",
    "version": "2012-08-10"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Exports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon Dynamodb Export Table Data to S3",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://dynamodb.{region}.amazonaws.com/#ExportTableToPointInTime",
            "headers": [
              {
                "name": "X-Amz-Target",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exports table data to an S3 bucket. The table must have point in time recovery enabled. You can export data in DynamoDB JSON or Amazon Ion format."
        }
      ]
    }
  ],
  "bundled": true
}