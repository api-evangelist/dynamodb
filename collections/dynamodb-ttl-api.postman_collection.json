          "name": "Amazon Dynamodb Enable or Disable Ttl on a Table",
          "request": {
            "name": "Amazon Dynamodb Enable or Disable Ttl on a Table",
            "description": {
              "content": "Enables or disables Time to Live (TTL) for the specified table. A successful UpdateTimeToLive call returns the current TimeToLiveSpecification. It can take up to one hour for the change to fully process.",
